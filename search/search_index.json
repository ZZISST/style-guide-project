39.</li> </ul>"},{"location":"doc-templates/readme-service/#_3","title":"\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0441\u0442\u0430\u0440\u0442","text":"<pre><code>git clone &lt;\u0430\u0434\u0440\u0435\u0441-\u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044f&gt;\ncd &lt;\u0438\u043c\u044f-\u0441\u0435\u0440\u0432\u0438\u0441\u0430&gt;\n</code></pre> <p>\u0413\u0434\u0435:</p> <ul> <li><code>&lt;\u0430\u0434\u0440\u0435\u0441-\u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044f&gt;</code> \u2014 \u0430\u0434\u0440\u0435\u0441 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044f \u0441\u0435\u0440\u0432\u0438\u0441\u0430 \u043d\u0430 GitHub;</li> <li><code>&lt;\u0438\u043c\u044f-\u0441\u0435\u0440\u0432\u0438\u0441\u0430&gt;</code> \u2014 \u0438\u043c\u044f \u043f\u0430\u043f\u043a\u0438 \u0441\u0435\u0440\u0432\u0438\u0441\u0430.</li> </ul>"},{"location":"doc-templates/readme-service/#_4","title":"\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f","text":"\u041f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e <code>&lt;\u0418\u041c\u042f_\u041f\u0415\u0420\u0415\u041c\u0415\u041d\u041d\u041e\u0419&gt;</code> \u0427\u0442\u043e \u0437\u0430\u0434\u0430\u0451\u0442 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0414\u0430 \u2014"},{"location":"doc-templates/readme-service/#_5","title":"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430","text":"<p>\u041a\u0430\u043a \u0443\u0431\u0435\u0434\u0438\u0442\u044c\u0441\u044f, \u0447\u0442\u043e \u0441\u0435\u0440\u0432\u0438\u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442: \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u0438 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0439 \u0432\u044b\u0432\u043e\u0434.</p>"},{"location":"doc-templates/reference/","title":"\u0428\u0430\u0431\u043b\u043e\u043d \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0430","text":""},{"location":"doc-templates/reference/#_2","title":"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435","text":"<p>\u0427\u0442\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a.</p>"},{"location":"doc-templates/reference/#_3","title":"\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b","text":"\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u0422\u0438\u043f \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e <code>name</code> \u0441\u0442\u0440\u043e\u043a\u0430 \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u2014"},{"location":"examples/","title":"\u041f\u0440\u0438\u043c\u0435\u0440\u044b","text":"<p>\u041f\u0440\u0438\u043c\u0435\u0440\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442, \u043a\u0430\u043a \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0441\u0442\u0430\u0439\u043b\u0433\u0430\u0439\u0434\u0430.</p> <ul> <li>\u0414\u043e \u0438 \u043f\u043e\u0441\u043b\u0435 \u2014 \u043f\u0440\u0430\u0432\u043a\u0430 \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c.</li> <li>README notify-service \u2014 README \u043f\u043e \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u00abREADME \u0441\u0435\u0440\u0432\u0438\u0441\u0430\u00bb.</li> <li>\u041a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c notify-service \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u2014 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u043f\u043e \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u00ab\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f\u00bb.</li> </ul>"},{"location":"examples/before-after/","title":"\u0414\u043e \u0438 \u043f\u043e\u0441\u043b\u0435","text":""},{"location":"examples/before-after/#_2","title":"\u041a\u0430\u043d\u0446\u0435\u043b\u044f\u0440\u0438\u0442","text":"<ul> <li>\u0414\u043e: \u00ab\u0414\u043b\u044f \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u043a\u043d\u043e\u043f\u043a\u0438\u00bb.</li> <li>\u041f\u043e\u0441\u043b\u0435: \u00ab\u0427\u0442\u043e\u0431\u044b \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u00bb.</li> </ul>"},{"location":"examples/before-after/#_3","title":"\u041f\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0439 \u0437\u0430\u043b\u043e\u0433","text":"<ul> <li>\u0414\u043e: \u00ab\u0424\u0430\u0439\u043b \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c\u00bb.</li> <li>\u041f\u043e\u0441\u043b\u0435: \u00ab\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0444\u0430\u0439\u043b\u00bb.</li> </ul>"},{"location":"examples/notify-service-local-run/","title":"\u041a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c notify-service \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e","text":"<p>\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0441\u0435\u0440\u0432\u0438\u0441 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 notify-service \u043d\u0430 \u0441\u0432\u043e\u0451\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435 \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0438 \u043e\u0442\u043b\u0430\u0434\u043a\u0438.</p>"},{"location":"examples/notify-service-local-run/#_1","title":"\u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c","text":"<ul> <li>\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 Go 1.22 \u0438\u043b\u0438 \u043d\u043e\u0432\u0435\u0435.</li> <li>\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 Docker 24 \u0438\u043b\u0438 \u043d\u043e\u0432\u0435\u0435.</li> <li>\u0421\u043a\u043b\u043e\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 \u0441\u0435\u0440\u0432\u0438\u0441\u0430:</li> </ul> <pre><code>git clone https://github.com/&lt;\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f&gt;/notify-service.git\n</code></pre> <p>\u0413\u0434\u0435 <code>&lt;\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f&gt;</code> \u2014 \u0438\u043c\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u043d\u0430 GitHub, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043b\u0435\u0436\u0438\u0442 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439.</p>"},{"location":"examples/notify-service-local-run/#_2","title":"\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044e","text":"<ol> <li> <p>\u041f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u043f\u0430\u043f\u043a\u0443 \u0441\u0435\u0440\u0432\u0438\u0441\u0430 \u0438 \u0441\u043a\u043e\u043f\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u0440\u0438\u043c\u0435\u0440 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438:</p> <pre><code>cd notify-service\ncp .env.example .env\n</code></pre> </li> <li> <p>\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0444\u0430\u0439\u043b <code>.env</code> \u0438 \u0443\u043a\u0430\u0436\u0438\u0442\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445:</p> <pre><code>DATABASE_URL=postgres://&lt;\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c&gt;:&lt;\u043f\u0430\u0440\u043e\u043b\u044c&gt;@localhost:5432/notify\nSMTP_HOST=&lt;\u0430\u0434\u0440\u0435\u0441-smtp-\u0441\u0435\u0440\u0432\u0435\u0440\u0430&gt;\n</code></pre> <p>\u0413\u0434\u0435:</p> <ul> <li><code>&lt;\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c&gt;</code> \u0438 <code>&lt;\u043f\u0430\u0440\u043e\u043b\u044c&gt;</code> \u2014 \u0443\u0447\u0451\u0442\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445;</li> <li><code>&lt;\u0430\u0434\u0440\u0435\u0441-smtp-\u0441\u0435\u0440\u0432\u0435\u0440\u0430&gt;</code> \u2014 \u0430\u0434\u0440\u0435\u0441 \u0442\u0435\u0441\u0442\u043e\u0432\u043e\u0433\u043e SMTP-\u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 <code>localhost:1025</code>.</li> </ul> </li> </ol>"},{"location":"examples/notify-service-local-run/#_3","title":"\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0441\u0435\u0440\u0432\u0438\u0441","text":"<ol> <li> <p>\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u043d\u044b\u0445:</p> <pre><code>docker compose up -d postgres\n</code></pre> </li> <li> <p>\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0441\u0435\u0440\u0432\u0438\u0441:</p> <pre><code>go run ./cmd/notify-service\n</code></pre> <p>\u0421\u0435\u0440\u0432\u0438\u0441 \u0432\u044b\u0432\u0435\u0434\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0435:</p> <pre><code>INFO notify-service started on :8080\n</code></pre> </li> </ol>"},{"location":"examples/notify-service-local-run/#_4","title":"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430","text":"<p>\u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441 \u043a \u043c\u0435\u0442\u043e\u0434\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f:</p> <pre><code>curl http://localhost:8080/health\n</code></pre> <p>\u0421\u0435\u0440\u0432\u0438\u0441 \u0432\u0435\u0440\u043d\u0451\u0442 \u043e\u0442\u0432\u0435\u0442:</p> <pre><code>{\"status\":\"ok\"}\n</code></pre>"},{"location":"examples/notify-service-local-run/#_5","title":"\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b","text":"\u041e\u0448\u0438\u0431\u043a\u0430 \u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c <code>connection refused</code> \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0411\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430 \u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 <code>docker compose up -d postgres</code> <code>address already in use</code> \u041f\u043e\u0440\u0442 8080 \u0437\u0430\u043d\u044f\u0442 \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u043e\u0440\u0442 \u0432 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 <code>HTTP_PORT</code> <code>DATABASE_URL is required</code> \u0412 \u0444\u0430\u0439\u043b\u0435 <code>.env</code> \u043d\u0435\u0442 \u0441\u0442\u0440\u043e\u043a\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0417\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435 <code>DATABASE_URL</code> \u0432 \u0444\u0430\u0439\u043b\u0435 <code>.env</code>"},{"location":"examples/notify-service-readme/","title":"README \u0441\u0435\u0440\u0432\u0438\u0441\u0430 notify-service","text":""},{"location":"examples/notify-service-readme/#_1","title":"\u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435","text":"<p>\u0421\u0435\u0440\u0432\u0438\u0441 notify-service \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435 \u0438 \u0432 Telegram. \u0414\u0440\u0443\u0433\u0438\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0442 \u0435\u043c\u0443 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0447\u0435\u0440\u0435\u0437 REST API.</p>"},{"location":"examples/notify-service-readme/#_2","title":"\u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f","text":"<ul> <li>Go 1.22 \u0438\u043b\u0438 \u043d\u043e\u0432\u0435\u0435.</li> <li>PostgreSQL 15 \u0438\u043b\u0438 \u043d\u043e\u0432\u0435\u0435.</li> <li>Docker 24 \u0438\u043b\u0438 \u043d\u043e\u0432\u0435\u0435 \u2014 \u0434\u043b\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445.</li> </ul>"},{"location":"examples/notify-service-readme/#_3","title":"\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0441\u0442\u0430\u0440\u0442","text":"<pre><code>git clone https://github.com/&lt;\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f&gt;/notify-service.git\ncd notify-service\ncp .env.example .env\ngo run ./cmd/notify-service\n</code></pre> <p>\u0413\u0434\u0435 <code>&lt;\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f&gt;</code> \u2014 \u0438\u043c\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u043d\u0430 GitHub, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043b\u0435\u0436\u0438\u0442 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439.</p> <p>\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u2014 \u0432 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 \u00ab\u041a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c notify-service \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u00bb.</p>"},{"location":"examples/notify-service-readme/#_4","title":"\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f","text":"\u041f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e <code>DATABASE_URL</code> \u0421\u0442\u0440\u043e\u043a\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043a PostgreSQL \u0414\u0430 \u2014 <code>SMTP_HOST</code> \u0410\u0434\u0440\u0435\u0441 SMTP-\u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u0434\u043b\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u043f\u0438\u0441\u0435\u043c \u0414\u0430 \u2014 <code>TELEGRAM_TOKEN</code> \u0422\u043e\u043a\u0435\u043d \u0431\u043e\u0442\u0430 Telegram \u041d\u0435\u0442 \u2014 <code>HTTP_PORT</code> \u041f\u043e\u0440\u0442, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u0435\u0440\u0432\u0438\u0441 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u041d\u0435\u0442 <code>8080</code> <code>LOG_LEVEL</code> \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043b\u043e\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f: <code>debug</code>, <code>info</code>, <code>warn</code>, <code>error</code> \u041d\u0435\u0442 <code>info</code>"},{"location":"examples/notify-service-readme/#_5","title":"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430","text":"<p>\u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441 \u043a \u043c\u0435\u0442\u043e\u0434\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f:</p> <pre><code>curl http://localhost:8080/health\n</code></pre> <p>\u0421\u0435\u0440\u0432\u0438\u0441 \u0432\u0435\u0440\u043d\u0451\u0442 \u043e\u0442\u0432\u0435\u0442:</p> <pre><code>{\"status\":\"ok\"}\n</code></pre>"}]}