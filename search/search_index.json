40\u043e\u0447\u043d\u043e\u0439.</li> <li>\u041d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0439\u0442\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432.</li> </ul>"},{"location":"formatting/#_3","title":"\u0421\u043f\u0438\u0441\u043a\u0438","text":"<ul> <li>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043c\u0430\u0440\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a, \u0435\u0441\u043b\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043d\u0435 \u0432\u0430\u0436\u0435\u043d.</li> <li>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u0443\u043c\u0435\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0434\u043b\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0448\u0430\u0433\u043e\u0432.</li> <li>\u041d\u0430\u0447\u0438\u043d\u0430\u0439\u0442\u0435 \u043f\u0443\u043d\u043a\u0442\u044b \u0441 \u043f\u0440\u043e\u043f\u0438\u0441\u043d\u043e\u0439 \u0431\u0443\u043a\u0432\u044b.</li> </ul>"},{"location":"formatting/#_4","title":"\u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435","text":"<ul> <li>\u041f\u043e\u043b\u0443\u0436\u0438\u0440\u043d\u044b\u0439 \u2014 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430.</li> <li>\u041a\u0443\u0440\u0441\u0438\u0432 \u2014 \u0442\u0435\u0440\u043c\u0438\u043d \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u043e\u043c \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0438.</li> <li><code>\u041c\u043e\u043d\u043e\u0448\u0438\u0440\u0438\u043d\u043d\u044b\u0439</code> \u2014 \u043a\u043e\u0434, \u043a\u043e\u043c\u0430\u043d\u0434\u044b, \u0438\u043c\u0435\u043d\u0430 \u0444\u0430\u0439\u043b\u043e\u0432.</li> </ul>"},{"location":"glossary/","title":"\u0413\u043b\u043e\u0441\u0441\u0430\u0440\u0438\u0439","text":"\u0422\u0435\u0440\u043c\u0438\u043d \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 Docs as Code \u041f\u043e\u0434\u0445\u043e\u0434, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u0432\u0435\u0434\u0451\u0442\u0441\u044f \u043a\u0430\u043a \u043a\u043e\u0434: \u0432 Git, \u0441 \u0440\u0435\u0432\u044c\u044e \u0438 CI PR (pull request) \u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0441\u043b\u0438\u044f\u043d\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0438\u0437 \u0432\u0435\u0442\u043a\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e CI \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f: \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u041b\u0438\u043d\u0442\u0435\u0440 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0442\u0435\u043a\u0441\u0442 \u043d\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c \u0421\u0442\u0430\u0439\u043b\u0433\u0430\u0439\u0434 \u0421\u0432\u043e\u0434 \u043f\u0440\u0430\u0432\u0438\u043b \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438"},{"location":"markdown/","title":"Markdown","text":"<p>\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0440\u0430\u0437\u043c\u0435\u0442\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442\u0441\u044f \u043b\u0438\u043d\u0442\u0435\u0440\u043e\u043c <code>markdownlint-cli2</code> \u0441 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0435\u0439 <code>.markdownlint-cli2.yaml</code>.</p> \u041f\u0440\u0430\u0432\u0438\u043b\u043e \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435 MD003 \u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0432 \u0441\u0442\u0438\u043b\u0435 ATX: <code># \u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a</code> MD004 \u041c\u0430\u0440\u043a\u0435\u0440 \u0441\u043f\u0438\u0441\u043a\u0430 \u2014 \u0434\u0435\u0444\u0438\u0441 <code>-</code> MD007 \u041e\u0442\u0441\u0442\u0443\u043f \u0432\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u2014 4 \u043f\u0440\u043e\u0431\u0435\u043b\u0430 MD013 \u0414\u043b\u0438\u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0438 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0430 MD029 \u041d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u044f \u0441\u043f\u0438\u0441\u043a\u0430 \u043f\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0443: 1, 2, 3 MD040 \u0423 \u0431\u043b\u043e\u043a\u0430 \u043a\u043e\u0434\u0430 \u0443\u043a\u0430\u0437\u0430\u043d \u044f\u0437\u044b\u043a MD050 \u041f\u043e\u043b\u0443\u0436\u0438\u0440\u043d\u044b\u0439 \u0447\u0435\u0440\u0435\u0437 \u0437\u0432\u0451\u0437\u0434\u043e\u0447\u043a\u0438: <code>**\u0442\u0435\u043a\u0441\u0442**</code>"},{"location":"markdown/#_1","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0431\u043b\u043e\u043a\u0430 \u043a\u043e\u0434\u0430","text":"<pre><code>npx markdownlint-cli2 \"**/*.md\"\n</code></pre>"},{"location":"specific/","title":"\u0421\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b","text":""},{"location":"specific/#_2","title":"\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430","text":"<p>\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043a\u043d\u043e\u043f\u043e\u043a \u0438 \u043f\u0443\u043d\u043a\u0442\u043e\u0432 \u043c\u0435\u043d\u044e \u0432\u044b\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u043f\u043e\u043b\u0443\u0436\u0438\u0440\u043d\u044b\u043c \u0438 \u043f\u0438\u0448\u0438\u0442\u0435 \u0442\u0430\u043a, \u043a\u0430\u043a \u043e\u043d\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u044b \u0432 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0435: \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c.</p>"},{"location":"specific/#_3","title":"\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f","text":"<p>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0431\u043b\u043e\u043a\u0438-\u043f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0432\u0430\u0436\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438:</p> <p>\u0412\u043d\u0438\u043c\u0430\u043d\u0438\u0435</p> <p>\u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c.</p>"},{"location":"specific/#_4","title":"\u0427\u0438\u0441\u043b\u0430 \u0438 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f","text":"<p>\u041e\u0442\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u0447\u0438\u0441\u043b\u043e \u043e\u0442 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c \u043f\u0440\u043e\u0431\u0435\u043b\u043e\u043c: 10 \u041c\u0411, 5 \u0441.</p>"},{"location":"spelling/","title":"\u041e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438 \u043f\u0443\u043d\u043a\u0442\u0443\u0430\u0446\u0438\u044f","text":""},{"location":"spelling/#_2","title":"\u0411\u0443\u043a\u0432\u0430 \u00ab\u0451\u00bb","text":"<p>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0451\u00bb \u0442\u0430\u043c, \u0433\u0434\u0435 \u0431\u0435\u0437 \u043d\u0435\u0451 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430: \u00ab\u0432\u0441\u0451\u00bb, \u00ab\u0432\u0441\u0451-\u0442\u0430\u043a\u0438\u00bb.</p>"},{"location":"spelling/#_3","title":"\u041a\u0430\u0432\u044b\u0447\u043a\u0438 \u0438 \u0442\u0438\u0440\u0435","text":"<ul> <li>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u0430\u0432\u044b\u0447\u043a\u0438-\u00ab\u0451\u043b\u043e\u0447\u043a\u0438\u00bb, \u0434\u043b\u044f \u0432\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u2014 \u201e\u043b\u0430\u043f\u043a\u0438\u201c.</li> <li>\u041c\u0435\u0436\u0434\u0443 \u0447\u0430\u0441\u0442\u044f\u043c\u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0434\u043b\u0438\u043d\u043d\u043e\u0435 \u0442\u0438\u0440\u0435 \u00ab\u2014\u00bb \u0441 \u043f\u0440\u043e\u0431\u0435\u043b\u0430\u043c\u0438.</li> <li>\u0412 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430\u0445 \u0447\u0438\u0441\u0435\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0442\u0438\u0440\u0435 \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u0435\u043b\u043e\u0432: 10\u201320.</li> </ul>"},{"location":"spelling/#_4","title":"\u0422\u043e\u0447\u043a\u0430 \u0432 \u043a\u043e\u043d\u0446\u0435","text":"<p>\u041d\u0435 \u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0442\u043e\u0447\u043a\u0443 \u0432 \u043a\u043e\u043d\u0446\u0435 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432 \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u0435\u0439 \u043a \u0440\u0438\u0441\u0443\u043d\u043a\u0430\u043c.</p>"},{"location":"tone/","title":"\u0422\u043e\u043d \u0438 \u0441\u0442\u0438\u043b\u044c","text":""},{"location":"tone/#_2","title":"\u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044e","text":"<ul> <li>\u041e\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u043a \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044e \u043d\u0430 \u00ab\u0432\u044b\u00bb \u0441\u043e \u0441\u0442\u0440\u043e\u0447\u043d\u043e\u0439 \u0431\u0443\u043a\u0432\u044b.</li> <li>\u041f\u0438\u0448\u0438\u0442\u0435 \u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u0437\u0430\u043b\u043e\u0433\u0435: \u00ab\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443\u00bb, \u0430 \u043d\u0435 \u00ab\u041a\u043d\u043e\u043f\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043d\u0430\u0436\u0430\u0442\u0430\u00bb.</li> <li>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u043e\u0432\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0435 \u0432 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f\u0445.</li> </ul>"},{"location":"tone/#_3","title":"\u0421\u0442\u0438\u043b\u044c","text":"<ul> <li>\u041f\u0438\u0448\u0438\u0442\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u043e: \u043e\u0434\u043d\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u043e\u0434\u043d\u0430 \u043c\u044b\u0441\u043b\u044c.</li> <li>\u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043a\u0430\u043d\u0446\u0435\u043b\u044f\u0440\u0438\u0442\u0430: \u00ab\u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443\u00bb \u2192 \u00ab\u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c\u00bb.</li> <li>\u041d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043e\u0446\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u0441\u043b\u043e\u0432\u0430: \u00ab\u043f\u0440\u043e\u0441\u0442\u043e\u00bb, \u00ab\u043b\u0435\u0433\u043a\u043e\u00bb, \u00ab\u043e\u0447\u0435\u0432\u0438